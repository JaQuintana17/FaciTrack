{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "views/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "crons": [
    { "path": "/tasks/minute", "schedule": "* * * * *" },
    { "path": "/tasks/hourly", "schedule": "0 * * * *" },
    { "path": "/tasks/calendar-sync", "schedule": "*/5 * * * *" }
  ]
}
